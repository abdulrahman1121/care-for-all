# Firebase web app config (from Firebase console > Project settings > Your apps). Copy this file to .env.local and fill it in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Local development only: set to "true" to use the Firebase emulators instead of the real project.
VITE_USE_FIREBASE_EMULATORS=
